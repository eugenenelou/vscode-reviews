{
  "name": "vscode-reviews",
  "displayName": "Reviews",
  "description": "Line-anchored review comments across any editor, exported as an AI-agent prompt.",
  "version": "0.0.1",
  "publisher": "eugene",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eugenenelou/vscode-reviews.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-reviews",
          "title": "Reviews",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "vscode-reviews": [
        {
          "id": "vscode-reviews.tree",
          "name": "Reviews"
        },
        {
          "id": "vscode-reviews.guide",
          "name": "Guide"
        }
      ]
    },
    "configuration": {
      "title": "Reviews",
      "properties": {
        "vscode-reviews.idleTimeoutMinutes": {
          "type": "number",
          "default": 60,
          "description": "Minutes of inactivity before adding a comment asks whether to continue the active review or start a new one."
        },
        "vscode-reviews.guideGrouping": {
          "type": "string",
          "enum": [
            "tierThenTopic",
            "topicThenTier"
          ],
          "default": "tierThenTopic",
          "enumDescriptions": [
            "Group each commit's files by tier, then by topic.",
            "Group each commit's files by topic, then by tier."
          ],
          "description": "How the Guide view nests a commit's files. Topics are left out when a commit has a single one."
        },
        "vscode-reviews.guideNotesInline": {
          "type": "boolean",
          "default": true,
          "description": "Show the Guide's line notes as comment threads in diffs."
        },
        "vscode-reviews.guideFileReason": {
          "type": "string",
          "enum": [
            "secondLine",
            "inline"
          ],
          "default": "secondLine",
          "enumDescriptions": [
            "Show a file's reason on its own row under the file.",
            "Show a file's reason after its path, on the same row."
          ],
          "description": "Where the Guide view shows each file's reason."
        }
      }
    },
    "commands": [
      {
        "command": "vscode-reviews.newReview",
        "title": "Reviews: New review"
      },
      {
        "command": "vscode-reviews.copyPrompt",
        "title": "Reviews: Copy prompt"
      },
      {
        "command": "vscode-reviews.createComment",
        "title": "Add comment"
      },
      {
        "command": "vscode-reviews.editComment",
        "title": "Edit"
      },
      {
        "command": "vscode-reviews.deleteComment",
        "title": "Delete"
      },
      {
        "command": "vscode-reviews.saveComment",
        "title": "Save"
      },
      {
        "command": "vscode-reviews.cancelEditComment",
        "title": "Cancel"
      },
      {
        "command": "vscode-reviews.openComment",
        "title": "Open comment location"
      },
      {
        "command": "vscode-reviews.openCommentRevision",
        "title": "Reviews: Open File at Revision"
      },
      {
        "command": "vscode-reviews.openCommentCurrent",
        "title": "Reviews: Open Current File"
      },
      {
        "command": "vscode-reviews.tree.copyPrompt",
        "title": "Copy Prompt",
        "icon": "$(copy)"
      },
      {
        "command": "vscode-reviews.tree.copyLink",
        "title": "Copy Link to Review",
        "icon": "$(link)"
      },
      {
        "command": "vscode-reviews.tree.deleteReview",
        "title": "Delete Review",
        "icon": "$(trash)"
      },
      {
        "command": "vscode-reviews.tree.editComment",
        "title": "Edit Comment",
        "icon": "$(edit)"
      },
      {
        "command": "vscode-reviews.tree.deleteComment",
        "title": "Delete Comment",
        "icon": "$(close)"
      },
      {
        "command": "vscode-reviews.markReviewed",
        "title": "Reviews: Mark reviewed",
        "icon": "$(check)"
      },
      {
        "command": "vscode-reviews.gitlens.markReviewed",
        "title": "Reviews: Mark reviewed",
        "icon": "$(check)"
      },
      {
        "command": "vscode-reviews.resyncCursor",
        "title": "Reviews: Resync review cursor",
        "icon": "$(sync)"
      },
      {
        "command": "vscode-reviews.guide.refresh",
        "title": "Reviews: Refresh guide",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-reviews.guide.openFile",
        "title": "Open Diff"
      },
      {
        "command": "vscode-reviews.guide.openMultiDiff",
        "title": "Open as Multi-Diff",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "vscode-reviews.guide.markReviewed",
        "title": "Mark Reviewed",
        "icon": "$(check)"
      },
      {
        "command": "vscode-reviews.guide.promoteNote",
        "title": "Add to Review",
        "icon": "$(comment-unresolved)"
      },
      {
        "command": "vscode-reviews.guide.groupByTopic",
        "title": "Reviews: Group Guide by Topic, then Tier",
        "icon": "$(tag)"
      },
      {
        "command": "vscode-reviews.guide.groupByTier",
        "title": "Reviews: Group Guide by Tier, then Topic",
        "icon": "$(circle-filled)"
      },
      {
        "command": "vscode-reviews.guide.hideNotes",
        "title": "Reviews: Hide Guide Notes in Diffs",
        "icon": "$(eye)"
      },
      {
        "command": "vscode-reviews.guide.showNotes",
        "title": "Reviews: Show Guide Notes in Diffs",
        "icon": "$(eye-closed)"
      },
      {
        "command": "vscode-reviews.guide.toggleFileReviewed",
        "title": "Reviews: Toggle File Reviewed"
      },
      {
        "command": "vscode-reviews.guide.reasonInline",
        "title": "Reviews: Show File Reasons Inline",
        "icon": "$(fold)"
      },
      {
        "command": "vscode-reviews.guide.reasonSecondLine",
        "title": "Reviews: Show File Reasons on a Second Line",
        "icon": "$(unfold)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vscode-reviews.createComment",
          "when": "false"
        },
        {
          "command": "vscode-reviews.editComment",
          "when": "false"
        },
        {
          "command": "vscode-reviews.deleteComment",
          "when": "false"
        },
        {
          "command": "vscode-reviews.saveComment",
          "when": "false"
        },
        {
          "command": "vscode-reviews.cancelEditComment",
          "when": "false"
        },
        {
          "command": "vscode-reviews.openComment",
          "when": "false"
        },
        {
          "command": "vscode-reviews.openCommentRevision",
          "when": "false"
        },
        {
          "command": "vscode-reviews.openCommentCurrent",
          "when": "false"
        },
        {
          "command": "vscode-reviews.tree.copyPrompt",
          "when": "false"
        },
        {
          "command": "vscode-reviews.tree.copyLink",
          "when": "false"
        },
        {
          "command": "vscode-reviews.tree.deleteReview",
          "when": "false"
        },
        {
          "command": "vscode-reviews.tree.editComment",
          "when": "false"
        },
        {
          "command": "vscode-reviews.tree.deleteComment",
          "when": "false"
        },
        {
          "command": "vscode-reviews.gitlens.markReviewed",
          "when": "false"
        },
        {
          "command": "vscode-reviews.guide.openFile",
          "when": "false"
        },
        {
          "command": "vscode-reviews.guide.openMultiDiff",
          "when": "false"
        },
        {
          "command": "vscode-reviews.guide.markReviewed",
          "when": "false"
        },
        {
          "command": "vscode-reviews.guide.promoteNote",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "vscode-reviews.createComment",
          "group": "inline",
          "when": "commentController == vscode-reviews"
        }
      ],
      "comments/comment/title": [
        {
          "command": "vscode-reviews.editComment",
          "group": "group@1",
          "when": "commentController == vscode-reviews && comment == canEdit"
        },
        {
          "command": "vscode-reviews.deleteComment",
          "group": "group@2",
          "when": "commentController == vscode-reviews && comment == canEdit"
        },
        {
          "command": "vscode-reviews.guide.promoteNote",
          "group": "inline",
          "when": "commentController == vscode-reviews-guide && comment == guideNote"
        }
      ],
      "comments/comment/context": [
        {
          "command": "vscode-reviews.saveComment",
          "group": "inline@1",
          "when": "commentController == vscode-reviews"
        },
        {
          "command": "vscode-reviews.cancelEditComment",
          "group": "inline@2",
          "when": "commentController == vscode-reviews"
        }
      ],
      "view/title": [
        {
          "command": "vscode-reviews.newReview",
          "when": "view == vscode-reviews.tree",
          "group": "navigation@1"
        },
        {
          "command": "vscode-reviews.copyPrompt",
          "when": "view == vscode-reviews.tree",
          "group": "navigation@2"
        },
        {
          "command": "vscode-reviews.markReviewed",
          "when": "view == vscode-reviews.tree",
          "group": "navigation@3"
        },
        {
          "command": "vscode-reviews.resyncCursor",
          "when": "view == vscode-reviews.tree",
          "group": "navigation@4"
        },
        {
          "command": "vscode-reviews.guide.refresh",
          "when": "view == vscode-reviews.guide",
          "group": "navigation@1"
        },
        {
          "command": "vscode-reviews.resyncCursor",
          "when": "view == vscode-reviews.guide",
          "group": "navigation@2"
        },
        {
          "command": "vscode-reviews.guide.groupByTopic",
          "when": "view == vscode-reviews.guide && config.vscode-reviews.guideGrouping != topicThenTier",
          "group": "navigation@0"
        },
        {
          "command": "vscode-reviews.guide.groupByTier",
          "when": "view == vscode-reviews.guide && config.vscode-reviews.guideGrouping == topicThenTier",
          "group": "navigation@0"
        },
        {
          "command": "vscode-reviews.guide.hideNotes",
          "when": "view == vscode-reviews.guide && config.vscode-reviews.guideNotesInline",
          "group": "navigation@0"
        },
        {
          "command": "vscode-reviews.guide.showNotes",
          "when": "view == vscode-reviews.guide && !config.vscode-reviews.guideNotesInline",
          "group": "navigation@0"
        },
        {
          "command": "vscode-reviews.guide.reasonInline",
          "when": "view == vscode-reviews.guide && config.vscode-reviews.guideFileReason != inline",
          "group": "navigation@0"
        },
        {
          "command": "vscode-reviews.guide.reasonSecondLine",
          "when": "view == vscode-reviews.guide && config.vscode-reviews.guideFileReason == inline",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-reviews.tree.copyPrompt",
          "when": "view == vscode-reviews.tree && viewItem == activeReview",
          "group": "inline@1"
        },
        {
          "command": "vscode-reviews.tree.copyLink",
          "when": "view == vscode-reviews.tree && viewItem == activeReview",
          "group": "inline@2"
        },
        {
          "command": "vscode-reviews.newReview",
          "when": "view == vscode-reviews.tree && viewItem == activeReview",
          "group": "inline@3"
        },
        {
          "command": "vscode-reviews.tree.deleteReview",
          "when": "view == vscode-reviews.tree && viewItem == activeReview",
          "group": "inline@4"
        },
        {
          "command": "vscode-reviews.tree.copyPrompt",
          "when": "view == vscode-reviews.tree && viewItem == pastReview",
          "group": "inline@1"
        },
        {
          "command": "vscode-reviews.tree.copyLink",
          "when": "view == vscode-reviews.tree && viewItem == pastReview",
          "group": "inline@2"
        },
        {
          "command": "vscode-reviews.tree.deleteReview",
          "when": "view == vscode-reviews.tree && viewItem == pastReview",
          "group": "inline@3"
        },
        {
          "command": "vscode-reviews.openCommentRevision",
          "when": "view == vscode-reviews.tree && viewItem == commentAtRevision",
          "group": "1_navigation@1"
        },
        {
          "command": "vscode-reviews.openCommentCurrent",
          "when": "view == vscode-reviews.tree && viewItem == commentAtRevision",
          "group": "1_navigation@2"
        },
        {
          "command": "vscode-reviews.tree.editComment",
          "when": "view == vscode-reviews.tree && viewItem =~ /^comment/",
          "group": "inline@1"
        },
        {
          "command": "vscode-reviews.tree.deleteComment",
          "when": "view == vscode-reviews.tree && viewItem =~ /^comment/",
          "group": "inline@2"
        },
        {
          "command": "vscode-reviews.gitlens.markReviewed",
          "when": "viewItem =~ /^gitlens:commit\\b/",
          "group": "9_reviews"
        },
        {
          "command": "vscode-reviews.guide.openMultiDiff",
          "when": "view == vscode-reviews.guide && viewItem =~ /^guide(Commit|Group)$/",
          "group": "inline@1"
        },
        {
          "command": "vscode-reviews.guide.markReviewed",
          "when": "view == vscode-reviews.guide && viewItem == guideCommit",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vscode-reviews.guide.toggleFileReviewed",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "focusedView == vscode-reviews.guide",
        "args": {
          "source": "view"
        }
      },
      {
        "command": "vscode-reviews.guide.toggleFileReviewed",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorFocus",
        "args": {
          "source": "editor"
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "vitest run",
    "package": "pnpm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
